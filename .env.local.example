# Contact form email delivery (https://resend.com)
# Create a free API key, verify your sending domain, then set these in Vercel.
RESEND_API_KEY=

# Where contact-form submissions are delivered
CONTACT_TO_EMAIL=jackie@kairoslearningsolutions.com

# Verified "from" address on your Resend domain
# (until your domain is verified, Resend allows onboarding@resend.dev)
CONTACT_FROM_EMAIL=Kairos Website <onboarding@resend.dev>

# Announcement banner (edited from /concepts)
# GLOBAL_CONFIG is set automatically by `vercel env pull` (read connection string for the
# "kairos-site" Global Config store). Saving needs a 4-digit PIN and a Vercel access token.
GLOBAL_CONFIG=
BANNER_PIN=
VERCEL_API_TOKEN=
